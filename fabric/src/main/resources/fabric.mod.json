{
	"schemaVersion": 1,
	"id": "seamlessportals",
	"version": "${version}",
	"name": "SeamlessPortals",
	"description": "Nether and end portals show the dimension on the other side, plus admin-defined custom portals. Install on the client to see through portals; on a Fabric server (or Paper with the SeamlessPortals plugin) for streaming, travel and /sportal.",
	"authors": ["Ryan"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.ryan.seamlessportals.SeamlessPortals"],
		"client": ["dev.ryan.seamlessportals.client.SeamlessPortalsClient"],
		"modmenu": ["dev.ryan.seamlessportals.client.ModMenuIntegration"]
	},
	"mixins": [
		"seamlessportals.mixins.json",
		{
			"config": "seamlessportals.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "seamlessportals.sodium.mixins.json",
			"environment": "client"
		},
		{
			"config": "seamlessportals.iris.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
